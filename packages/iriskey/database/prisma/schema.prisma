generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  enabled     Boolean   @default(true)
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  providerConfigs ProviderConfig[]
  featureFlags    FeatureFlag[]

  @@index([enabled])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       Profile?
  accounts      Account[]
  sessions      Session[]
  roles         Role[]
  permissions   Permission[]
  auditLogs     AuditLog[]
  credits       Credits?
  settings      Settings?

  @@index([email])
  @@index([createdAt])
}

model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio           String?
  avatar        String?
  timezone      String   @default("UTC")
  language      String   @default("en")
  preferences   Json     @default("{}")
  onboardingCompleted Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([provider])
}

model Session {
  id        String   @id @default(cuid())
  sessionToken String @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([sessionToken])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  type       String   @default("email-verify")
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
  @@index([token])
  @@index([expires])
}

model Role {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  permissions Permission[]
  users       User[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
}

model Permission {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  resource    String
  action      String
  roles       Role[]
  users       User[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([resource, action])
  @@index([resource])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  productId String?
  action    String
  resource  String
  details   Json
  ipAddress String?
  userAgent String?
  status    String   @default("success")
  error     String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([productId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}

model Credits {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance          Int      @default(1000)
  spent            Int      @default(0)
  monthlyReset     Int      @default(1000)
  lastResetDate    DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

model ProviderConfig {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  type      String
  enabled   Boolean   @default(false)
  priority  Int       @default(0)
  config    Json
  secrets   Json
  health    String    @default("unknown")
  lastCheck DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([productId, name])
  @@index([productId])
  @@index([type])
  @@index([enabled])
}

model Settings {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  twoFactorEnabled Boolean  @default(false)
  emailNotifications Boolean @default(true)
  publicProfile    Boolean  @default(false)
  darkMode         Boolean  @default(false)
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

model FeatureFlag {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  enabled   Boolean   @default(false)
  rollout   Int       @default(0)
  targets   Json      @default("[]")
  metadata  Json      @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([productId, name])
  @@index([productId])
  @@index([enabled])
}

// LAO Learning Models

model LearnerGoal {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Goal details
  description   String   // "What I want to achieve"
  problem       String   // "What task takes too much time?"
  timeframe     String   // "8 weeks", "3 months", etc.
  confidence    Float    @default(0.5) // 0-1: learner's confidence in achieving goal

  // Status
  status        String   @default("active") // active, completed, paused
  progress      Int      @default(0) // 0-100%

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  missions      Mission[]
  portfolio     Portfolio[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Mission {
  id            String   @id @default(cuid())
  goalId        String
  goal          LearnerGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Mission details
  title         String   // "Solve Your First Real Problem with AI"
  problemArea   String   // "Writing", "Email", "Admin", etc.
  solutionType  String   // "ContentAssistant", "EmailAssistant", "IdeaGenerator", etc.
  solutionDescription String // "AI Content Assistant for LinkedIn"

  // Instructions for the coach
  instructions  String   // JSON: step-by-step guide for building

  // Status
  status        String   @default("active") // active, in_progress, completed, abandoned
  startedAt     DateTime?
  completedAt   DateTime?

  // Learner interaction
  confidenceAtStart Float?  // Confidence when starting mission
  confidenceAtEnd   Float?  // Confidence after completion
  timeSpent         Int?    // Minutes spent

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assets        Asset[]
  portfolio     Portfolio?

  @@index([goalId])
  @@index([userId])
  @@index([status])
  @@index([completedAt])
}

model Asset {
  id            String   @id @default(cuid())
  missionId     String
  mission       Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Asset details
  name          String   // "AI Content Assistant", "Email Template", etc.
  description   String   // What it does
  type          String   // "assistant", "template", "workflow", "tool", etc.

  // The actual built content
  content       Json     // The artifact created (prompt, config, etc.)
  metadata      Json     @default("{}")

  // Usage
  isInUseToday  Boolean  @default(false)
  useCount      Int      @default(0)
  lastUsedAt    DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([missionId])
  @@index([userId])
  @@index([type])
}

model Portfolio {
  id            String   @id @default(cuid())
  missionId     String   @unique
  mission       Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  goalId        String
  goal          LearnerGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // What they built
  problemSolved String   // "Writing LinkedIn posts"
  solutionCreated String // "AI Content Assistant"

  // How they feel about it
  reflection    String?  // Answer to "What surprised you?"
  confidenceGained Float? // Change in confidence (0-1)

  // Evidence for graph
  timeSpentMinutes Int?
  missionCompletedAt DateTime @default(now())
  status        String   @default("in_daily_use") // in_daily_use, completed, planned

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([goalId])
  @@index([userId])
  @@index([missionCompletedAt])
}

model LearnerState {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Overall confidence in ability to learn and build
  overallConfidence Float @default(0.5) // 0-1

  // How many problems solved
  problemsSolved Int @default(0)

  // When will they likely return
  predictedReturnDate DateTime?

  // Graph-sourced state (updated by engine)
  graphMasteryLevel Int? // 0-100, from knowledge engine
  graphConfidence Float? // 0-1, from belief engine

  // When was state last updated
  lastUpdatedAt DateTime @default(now())

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// AI Coach conversation state
model CoachConversation {
  id            String   @id @default(cuid())
  missionId     String
  userId        String

  // Conversation flow
  step          Int      @default(0) // 0: problem, 1: explore, 2: recommend, 3: build
  messages      Json     @default("[]") // Array of {role: "user"|"coach", content: "..."}

  // Learner's stated problem
  problem       String?  // "What task takes too much time?"

  // Coach's understanding
  exploration   String?  // Notes from exploration
  recommendedSolution String? // What the coach recommends

  // Build state
  buildingPhase String? // "setup", "configuration", "testing", "completion"

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  expiresAt     DateTime // Conversation expires after 24 hours

  @@index([userId])
  @@index([missionId])
  @@index([expiresAt])
}
