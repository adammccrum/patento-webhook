################################################################################
# Phase 1-3: Core Application Configuration
################################################################################
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

################################################################################
# Phase 3: External Service URLs
################################################################################
VOICEBOX_API_URL=http://localhost:8000
COMFYUI_API_URL=http://localhost:8188
IRISKEY_API_URL=http://localhost:9000
LAO_API_URL=http://localhost:8080

################################################################################
# Phase 4A: Database Configuration
################################################################################
# SQLite: DATABASE_URL=sqlite:./dev.db (development only)
# PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/patento_dev
# Connection pooling configuration
DATABASE_URL=sqlite:./dev.db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_MIGRATION_TABLE=knex_migrations

################################################################################
# Phase 4A: Authentication - JWT & Session Secrets
################################################################################
# CRITICAL: Change these in production. Minimum 32 bytes each.
# Generate with: openssl rand -base64 32
JWT_SECRET=change-this-in-production-minimum-32-bytes
JWT_REFRESH_SECRET=change-this-in-production-minimum-32-bytes
SESSION_SECRET=change-this-in-production-minimum-32-bytes

################################################################################
# Phase 4A: Token & Session Expiration
################################################################################
# Access token: 15 minutes (900 seconds) - short-lived
ACCESS_TOKEN_EXPIRY_SECONDS=900
# Refresh token: 7 days (604800 seconds) - long-lived
REFRESH_TOKEN_EXPIRY_SECONDS=604800
# Session: 24 hours (86400000 ms)
SESSION_MAX_AGE_MS=86400000

################################################################################
# Phase 4A: Security & HTTPS
################################################################################
# Enforce HTTPS in production (disables HTTP fallback)
FORCE_HTTPS=false
# Allow development-only security bypasses (set to false in production)
ALLOW_DEVELOPMENT_BYPASSES=true

################################################################################
# Phase 4B: API Rate Limiting
################################################################################
# Enable/disable rate limiting globally
RATE_LIMIT_ENABLED=true
# Rate limit window: 60 seconds
RATE_LIMIT_WINDOW_MS=60000
# Max requests per user per window: 100 requests/min
RATE_LIMIT_MAX_REQUESTS_USER=100
# Max requests per IP per window: 1000 requests/min
RATE_LIMIT_MAX_REQUESTS_IP=1000

################################################################################
# Phase 4B: CORS & HTTP Security
################################################################################
# CORS origin(s) - comma-separated if multiple
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true
# CSP header policy (set in production)
CONTENT_SECURITY_POLICY=default-src 'self'

################################################################################
# Phase 4C: Audit & Integrity
################################################################################
# Audit log retention: 7 years (2555 days)
AUDIT_RETENTION_DAYS=2555
# Enable hash chain verification on audit reads
AUDIT_CHAIN_VERIFICATION_ENABLED=true

################################################################################
# Phase 4C: IrisKey Biometric Authorization
################################################################################
# Enable real IrisKey connection (false = use mock adapter)
IRISKEY_REAL_CONNECTION=false
# IrisKey API key (required if IRISKEY_REAL_CONNECTION=true)
IRISKEY_API_KEY=
# IrisKey API URL override (optional, uses IRISKEY_API_URL from Phase 3)
IRISKEY_API_KEY_ROTATION_DAYS=90

################################################################################
# Phase 4C: OIDC Integration
################################################################################
# Enable OIDC provider integration (not yet implemented)
FEATURE_OIDC_ENABLED=false
OIDC_PROVIDER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

################################################################################
# Phase 4 Feature Flags
################################################################################
# Enable IrisKey biometric authorization features
FEATURE_IRISKEY_ENABLED=true
# Enable OIDC/SSO integration
FEATURE_OIDC_ENABLED=false

################################################################################
# Production Security Checklist (NODE_ENV=production)
################################################################################
# Before deploying to production, verify:
# [ ] NODE_ENV=production
# [ ] DATABASE_URL uses PostgreSQL (not SQLite)
# [ ] JWT_SECRET is set to a strong random value
# [ ] JWT_REFRESH_SECRET is set to a strong random value
# [ ] SESSION_SECRET is set to a strong random value
# [ ] FORCE_HTTPS=true
# [ ] ALLOW_DEVELOPMENT_BYPASSES=false
# [ ] All external service URLs are configured
# [ ] CORS_ORIGIN is set to your domain(s)
# [ ] TLS/SSL certificates are installed
# [ ] Secrets are stored in secure vault, not in VCS
