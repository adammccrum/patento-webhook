# Product Configuration
PRODUCT_ID="lao"
PRODUCT_NAME="LAO - AI Learning Operating System"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lao?schema=public"
DB_MAX_CONNECTIONS="10"
DB_MIN_CONNECTIONS="2"

# Authentication
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"
JWT_EXPIRES_IN="30d"
PASSWORD_HASH_ROUNDS="12"
EMAIL_VERIFICATION_EXPIRES_IN="24h"
PASSWORD_RESET_EXPIRES_IN="1h"

# Transactional email — password reset and email confirmation.
# Not optional for a real deployment. With none of these set the app still
# runs, but nothing is delivered: the link is written to the server log and a
# warning is logged. Anyone who forgets their password is locked out.
# Set either the HTTP pair (Resend, Postmark and similar) or SMTP_URL.
EMAIL_FROM="LAO Academy <noreply@lao.academy>"
EMAIL_API_URL=""
EMAIL_API_KEY=""
SMTP_URL=""

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Redis (optional)
REDIS_URL="redis://localhost:6379"

# Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# API Configuration
API_BASE_URL="http://localhost:3000/api"

# Logging
LOG_LEVEL="info"

# Collaborator — language model providers.
# Configure at least one. With none set, the app still runs: the collaborator
# says plainly that it cannot suggest improvements, and solutions stay fully
# editable by hand. The workspace never learns which of these served a request.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Any OpenAI-compatible server: Ollama, vLLM, llama.cpp, OpenRouter, Together.
# This is how self-hosted and open-weight models are reached.
OPENAI_COMPATIBLE_BASE_URL=""
OPENAI_COMPATIBLE_MODEL=""
OPENAI_COMPATIBLE_API_KEY=""
OPENAI_COMPATIBLE_VENDOR="self-hosted"
# Set true when the server cannot enforce a JSON schema natively.
OPENAI_COMPATIBLE_NO_STRUCTURED_OUTPUT="false"
